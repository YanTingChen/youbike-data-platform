# 由 Ansible 產生（deploy/ansible/roles/app/templates/env.j2），請勿在機器上手動修改

# 讓機器上直接下 docker compose 指令時，自動套用正式環境的設定與要啟動的服務
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES={{ compose_profiles | join(',') }}

# 應用程式設定。沒有 GOOGLE_APPLICATION_CREDENTIALS：GCP 憑證用 VM 掛載的 Service Account
{% for key, value in app_env.items() %}
{{ key }}={{ value }}
{% endfor %}

# 容器以部署帳號的身分執行，才能寫入掛載進去的 dbt 目錄
AIRFLOW_UID={{ getent_passwd[ansible_user][1] }}

POSTGRES_PASSWORD={{ postgres_password }}
AIRFLOW_JWT_SECRET={{ airflow_jwt_secret }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
GRAFANA_DB_PASSWORD={{ grafana_db_password }}

DEMO_USER={{ demo_user }}
AIRFLOW_HOST={{ airflow_host }}
GRAFANA_HOST={{ grafana_host }}
